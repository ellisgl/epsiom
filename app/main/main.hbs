<p>
    Session ID from Express: {{ssid_ex}}
</p>
<p>
    User ID from Express: {{userid_ex}}
</p>
<p>
    Session ID from Socket.io <span id="ssid_sio">...</span>
</p>
<p>
    User ID from Socket.io <span id="user_id">...</span>
</p>
<form action="/logout" method="post">
    <button type="submit">Log out</button>
</form>
<script>
    const socket = io();

    socket.on('set_stuff', function (data)
    {
        document.getElementById('ssid_sio').textContent = data.ssid;
        document.getElementById('user_id').textContent = data.uid;
    });
</script>
