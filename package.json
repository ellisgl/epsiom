{
  "name": "epsiom",
  "version": "1.0.0",
  "description": "Boilerplate for Express.js, Passport.js, Socket.io, MySQL and Roles",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "dev": "node --watch --env-file-if-exists=.env index.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.22"
  },
  "author": "Kenneth Ellis McCall",
  "license": "BSD-3-Clause",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-hbs": "^3.0.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "mysql2": "^3.24.6",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^12.2.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "handlebars": "^4.7.10",
    "mysql2": "$mysql2"
  }
}
