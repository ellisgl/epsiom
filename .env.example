# Copy to .env; `npm start` and `npm run dev` load it automatically.
NODE_ENV=development
PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_USER=epsiom
DB_PASSWORD=epsiom
DB_NAME=epsiom
DB_POOL_SIZE=10

# Required when NODE_ENV=production
SESSION_SECRET=change-me
SESSION_KEY=epsiom
# Session lifetime and expired-session cleanup interval, in ms
SESSION_EXPIRATION=3600000
SESSION_CLEAN=900000
